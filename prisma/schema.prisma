generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(uuid()) @db.Uuid
  auth0Sub             String            @unique @map("auth0_sub")
  email                String            @unique
  name                 String?
  picture              String?
  roles                String[]          @default(["user"])
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  lastLoginAt          DateTime?         @map("last_login_at")
  accounts             Account[]
  apiKeys              ApiKey[]
  sources              Source[]
  createdSources       Source[]          @relation("SourceCreator")
  preferences          UserPreference?
  billingUsage         BillingUsage?
  falkorDbConnections  FalkorDbConnection[]
  workspaceMembers     WorkspaceMember[]
  invitedMembers       WorkspaceMember[] @relation("InvitedBy")
  onboardingCompleted        Boolean              @default(false) @map("onboarding_completed")
  userIntent                 String?              @map("user_intent")
  dashboardPreset            String?              @map("dashboard_preset")
  subscriptionTier           String               @default("free") @map("subscription_tier")
  subscriptionStatus         String?              @default("active") @map("subscription_status")
  subscriptionEndsAt         DateTime?            @map("subscription_ends_at")
  monthlyRequestCount        Int                  @default(0) @map("monthly_request_count")
  monthlyRequestResetAt      DateTime?            @map("monthly_request_reset_at")
  storageUsedBytes           BigInt               @default(0) @map("storage_used_bytes")

  @@map("users")
}

model Source {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  createdBy   String    @map("created_by") @db.Uuid
  type        String    @db.VarChar(50) // 'repo', 'doc', 'log_app'
  name        String    @db.VarChar(255)
  url         String?   @db.VarChar(500)
  provider    String?   @db.VarChar(50) // 'github', 'gitlab', 'notion', 'google_drive', etc.
  externalId  String?   @map("external_id") @db.VarChar(255) // External provider's ID for this source
  config      Json?     @default("{}")
  status      String    @default("active") @db.VarChar(50)
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User      @relation("SourceCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([createdBy])
  @@index([type])
  @@index([provider])
  @@index([externalId])
  @@map("sources")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  keyHash    String    @unique @map("key_hash")
  keyPrefix  String    @map("key_prefix")
  scopes     String[]  @default(["read"])
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  rateLimit  Int       @default(1000) @map("rate_limit")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model UserPreference {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  theme               String   @default("system")
  language            String   @default("en")
  timezone            String   @default("UTC")
  defaultModel        String   @default("gpt-4") @map("default_model")
  embeddingModel      String   @default("gemini-embedding-2") @map("embedding_model")
  enableNotifications Boolean  @default(true) @map("enable_notifications")
  emailDigest         String   @default("weekly") @map("email_digest")
  customSettings      Json?    @default("{}") @map("custom_settings")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model BillingUsage {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  subscriptionTier   String   @default("free") @map("subscription_tier")
  reposCount         Int      @default(0) @map("repos_count")
  docsCount          Int      @default(0) @map("docs_count")
  lastUpdated        DateTime @updatedAt @map("last_updated")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_usage")
}

// ============================================================================
// Customer-owned FalkorDB connections (Cloud / self-hosted / BYOC)
// ============================================================================
// NOTE: This table stores connection METADATA ONLY — host/port/username,
// graph name, TLS settings and secret *references*. The actual password and
// certificate material live in the `secrets` table (AES-256-GCM encrypted),
// never in plaintext application storage.

model FalkorDbConnection {
  id                          String    @id @default(uuid()) @db.Uuid
  customerId                  String    @map("customer_id") @db.Uuid
  name                        String    @db.VarChar(255)
  host                        String    @db.VarChar(255)
  port                        Int
  username                    String?   @db.VarChar(255)
  passwordSecretRef           String?   @map("password_secret_ref") @db.VarChar(500)
  graphName                   String    @map("graph_name") @db.VarChar(255)
  tlsEnabled                  Boolean   @default(false) @map("tls_enabled")
  caCertificateSecretRef      String?   @map("ca_certificate_secret_ref") @db.VarChar(500)
  clientCertificateSecretRef  String?   @map("client_certificate_secret_ref") @db.VarChar(500)
  clientKeySecretRef          String?   @map("client_key_secret_ref") @db.VarChar(500)
  topology                    String?   @db.VarChar(20) // 'standalone' | 'sentinel' | 'cluster'
  deploymentType              String?   @map("deployment_type") @db.VarChar(20) // metadata only: 'cloud' | 'self_hosted' | 'byoc' | 'unknown'
  sentinelMasterName          String?   @map("sentinel_master_name") @db.VarChar(255)
  status                      String    @default("active") @db.VarChar(20)
  lastTestedAt                DateTime? @map("last_tested_at")
  lastTestStatus              String?   @map("last_test_status") @db.VarChar(20) // 'passed' | 'failed'
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  graphs   Graph[]

  @@index([customerId])
  @@map("falkordb_connections")
}

// ============================================================================
// Encrypted secret store
// ============================================================================
// Generic application secret store. Values are encrypted with AES-256-GCM
// before they touch the database (see services/secret-store.ts). The database
// only ever holds ciphertext, IV and auth tag.

model Secret {
  id         String   @id @default(uuid()) @db.Uuid
  secretRef  String   @unique @map("secret_ref") @db.VarChar(500)
  ownerId    String   @map("owner_id") @db.Uuid
  purpose    String   @default("falkordb") @db.VarChar(50)
  algorithm  String   @default("aes-256-gcm") @db.VarChar(30)
  keyVersion Int      @default(1) @map("key_version")
  ciphertext String   @db.Text
  iv         String   @map("iv") @db.Text
  authTag    String   @map("auth_tag") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("secrets")
}

// ============================================================================
// Workspace models
// ============================================================================

model Workspace {
  id              String            @id @db.VarChar(255)
  name            String            @db.VarChar(255)
  activeGraphId   String?           @map("active_graph_id") @db.VarChar(255)
  settings        Json?             @default("{}")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  
  // Relations
  members         WorkspaceMember[]
  sources         Source[]
  graphs          Graph[]
  activeGraph     Graph?            @relation("ActiveGraph", fields: [activeGraphId], references: [id], onDelete: SetNull)
  
  @@index([activeGraphId])
  @@map("workspaces")
}

model WorkspaceMember {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  workspaceId  String    @map("workspace_id") @db.VarChar(255)
  role         String    @db.VarChar(20) // 'ADMIN' | 'MEMBER'
  joinedAt     DateTime  @default(now()) @map("joined_at")
  invitedBy    String?   @map("invited_by") @db.Uuid
  
  // Relations
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter      User?     @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)
  
  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@index([role])
  @@map("workspace_members")
}

model Graph {
  id                    String      @id @db.VarChar(255)
  workspaceId           String      @map("workspace_id") @db.VarChar(255)
  name                  String      @db.VarChar(255)
  type                  String      @db.VarChar(20) // 'CONFUSE' | 'BYODB'
  status                String      @default("ACTIVE") @db.VarChar(20) // 'ACTIVE' | 'PROVISIONING' | 'FAILED' | 'DELETED'
  falkorDbConnectionId  String?     @map("falkordb_connection_id") @db.Uuid
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deletedAt             DateTime?   @map("deleted_at")
  
  // Relations
  workspace             Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  falkorDbConnection    FalkorDbConnection? @relation(fields: [falkorDbConnectionId], references: [id], onDelete: SetNull)
  activeInWorkspaces    Workspace[] @relation("ActiveGraph")
  
  @@index([workspaceId])
  @@index([type])
  @@index([status])
  @@index([falkorDbConnectionId])
  @@map("graphs")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  workspaceId  String?  @map("workspace_id") @db.VarChar(255)
  action       String   @db.VarChar(100)
  entityType   String   @map("entity_type") @db.VarChar(50)
  entityId     String?  @map("entity_id") @db.VarChar(255)
  metadata     Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(50)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

model PendingInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @db.VarChar(255)
  workspaceId String    @map("workspace_id") @db.VarChar(255)
  invitedBy   String    @map("invited_by") @db.Uuid
  token       String    @unique @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([email])
  @@index([workspaceId])
  @@index([token])
  @@map("pending_invitations")
}

// These tables are managed by the Rust processing services (doc-uni-proc, repo-uni-proc)
// and are included here for reference only. They are not managed by Prisma migrations.
model FileMetadata {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_id    String    @db.VarChar(255)
  filename     String    @db.VarChar(255)
  file_type    String    @db.VarChar(50)
  language     String?   @db.VarChar(50)
  size_bytes   Int?
  line_count   Int?
  processed_at DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([source_id, filename])
  @@map("file_metadata")
  @@index([source_id], map: "idx_file_metadata_source_id")
}


model ChunkSnapshot {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_id       String    @db.VarChar(255)
  filename        String    @db.VarChar(255)
  start_byte      BigInt    @db.BigInt
  end_byte        BigInt    @db.BigInt
  chunk_key       String    @db.VarChar(255)
  chunk_hash      String    @db.VarChar(255)
  commit_id       String?   @db.VarChar(255)
  embedding_model String    @db.VarChar(100)
  last_indexed_at DateTime? @db.Timestamptz(6)
  tombstone       Boolean   @default(false)

  @@map("chunk_snapshot")
  @@index([source_id, filename], map: "idx_chunk_snapshot_source_file")
  @@index([chunk_key], map: "idx_chunk_snapshot_key")
}




